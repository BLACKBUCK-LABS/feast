<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">
    <Properties>
        <Property name="basePath">/var/log/blackbuck</Property>
        <Property name="JSON_LOG_PATTERN">
            {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%p","thread":"%t","logger":"%c{1.}","message":"%enc{%m}{JSON}"}%n%ex{full}{separator(|)}%n
        </Property>
    </Properties>
    <Appenders>
        <!-- App logs and errors both land here as one JSON-per-line stream; error-only
             view is a jq/grep filter on level, not a second file, so nothing needs a
             second rotation policy to stay in sync. -->
        <RollingFile name="appLog"
                     fileName="${basePath}/feast-serving.log"
                     filePattern="${basePath}/archive/feast-serving-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${JSON_LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20">
                <Delete basePath="${basePath}/archive" maxDepth="1">
                    <IfFileName glob="feast-serving-*.log.gz"/>
                    <IfLastModified age="14d"/>
                    <IfAny>
                        <IfAccumulatedFileSize exceeds="5GB"/>
                        <IfLastModified age="14d"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- stdout mirror so `docker logs`/systemd journal capture the same stream during
             local runs and incident debugging, without needing shell access to the box. -->
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="${JSON_LOG_PATTERN}"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Third-party libraries at info are pure noise at our volume; only surface their
             warnings and above. Bump back to debug per-logger when chasing a specific issue. -->
        <Logger name="io.netty" level="warn"/>
        <Logger name="io.grpc" level="warn"/>
        <Logger name="io.grpc.netty" level="warn"/>
        <Logger name="io.lettuce" level="warn"/>
        <Logger name="org.apache.zookeeper" level="warn"/>
        <Logger name="org.apache.kafka" level="warn"/>

        <Root level="info">
            <AppenderRef ref="appLog"/>
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
